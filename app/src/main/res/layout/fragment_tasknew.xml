<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.tasks.newtask.TasknewFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#fbfaff">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/newtask_bottom_cons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/newtask_btn_prev_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/default_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/img_ios_arrow_left"
                android:padding="@dimen/space_margin"
                android:src="@drawable/ic_ios_arrow_left"
                app:layout_constraintBottom_toBottomOf="@id/newtask_month_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/newtask_month_name" />

            <TextView
                android:id="@+id/newtask_month_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi"
                android:padding="@dimen/space_margin"
                android:text="@string/example_month_name"
                android:textColor="@color/black"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/newtask_btn_next_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/default_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/img_ios_arrow_right"
                android:padding="@dimen/space_margin"
                android:src="@drawable/ic_arrow_ios_right"
                app:layout_constraintBottom_toBottomOf="@id/newtask_month_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/newtask_month_name" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newtask_rc_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/default_margin"
                android:layout_marginEnd="@dimen/default_margin"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/newtask_month_name"
                tools:listitem="@layout/adp_item_day" />

            <com.example.tasksapp.view.CustomTimePicker
                android:id="@+id/newtask_customtimepicker"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newtask_rc_days"
                app:layout_constraintWidth_percent="0.75" />

            <Button
                android:id="@+id/newtask_add_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/default_margin_2"
                android:layout_marginTop="@dimen/default_margin_2"
                android:text="@string/newtask_add_member"
                android:textColor="@color/white"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newtask_customtimepicker" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/newtask_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingHorizontal="@dimen/default_margin_2"
            android:paddingTop="@dimen/default_margin"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/newtask_btnback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:contentDescription="@string/img_back"
                android:cropToPadding="true"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="@id/newtask_more"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/newtask_more" />

            <TextView
                android:id="@+id/newtask_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_margin"
                android:fontFamily="@font/inter_semi"
                android:text="@string/newtask_task_title"
                android:textColor="@color/black"
                android:textSize="26sp"
                app:layout_constraintBottom_toBottomOf="@id/newtask_btnback"
                app:layout_constraintStart_toEndOf="@id/newtask_btnback"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newtask_more"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi"
                android:letterSpacing="0.05"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/addmem_finish"
                android:textAlignment="textEnd"
                android:textAllCaps="false"
                android:textColor="@color/purple_deep"
                app:iconPadding="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/newtask_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/newtask_header">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/newtask_top_cons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingHorizontal="@dimen/default_margin_2">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/newtask_name_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/default_margin_2"
                    android:hint="@string/newtask_task_name"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/purple_deep"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/newtask_title_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@android:color/transparent"
                        android:inputType="text"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>
                <!--tanda-->
                <LinearLayout
                    android:id="@+id/newtask_next_const"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/default_margin"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/newtask_name_task">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/newtask_description_task"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/newtask_description_name"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/purple_deep">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/newtask_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@android:color/transparent"
                            android:inputType="text"
                            android:textColor="@android:color/black" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/newtask_bt_task"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin">

                        <LinearLayout
                            android:id="@+id/newtask_ic_remember"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/img_ios_arrow_right"
                                android:src="@drawable/ic_add_box" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_margin"
                                android:fontFamily="@font/inter_regular"
                                android:text="@string/newtask_add_sub"
                                android:textColor="@color/black"
                                android:textSize="15sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/newtask_linear_sub_task"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@id/newtask_ic_remember"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/default_margin"
                            android:background="@color/gray_stroke"
                            app:layout_constraintTop_toBottomOf="@id/newtask_linear_sub_task" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/newtask_bt_add_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin">

                        <ImageView
                            android:id="@+id/newtask_ic_add"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/img_ios_arrow_right"
                            android:src="@drawable/ic_bell"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_remember_text"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_margin"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/newtask_reminder"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_remember_text"
                            app:layout_constraintStart_toEndOf="@id/newtask_ic_add"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/newtask_remember_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_circle_text"
                            android:fontFamily="@font/inter_semi"
                            android:gravity="center"
                            android:text="@string/example_number_0"
                            android:textAlignment="center"
                            android:textColor="@color/purple_deep"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/default_margin"
                            android:background="@color/gray_stroke"
                            app:layout_constraintTop_toBottomOf="@id/newtask_ic_add" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/newtask_bt_add_priority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin">

                        <ImageView
                            android:id="@+id/newtask_ic_priority"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/img_ios_arrow_right"
                            android:src="@drawable/ic_flag"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_priority_text"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_margin"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/newtask_priority"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_priority_text"
                            app:layout_constraintStart_toEndOf="@id/newtask_ic_priority"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/newtask_priority_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rd_8"
                            android:fontFamily="@font/inter_semi"
                            android:gravity="center"
                            android:text="@string/default1"
                            android:textAlignment="center"
                            android:textColor="@color/purple_deep"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/default_margin"
                            android:background="@color/gray_stroke"
                            app:layout_constraintTop_toBottomOf="@id/newtask_ic_priority" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/newtask_bt_add_postpone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin">

                        <ImageView
                            android:id="@+id/newtask_ic_postpone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/img_ios_arrow_right"
                            android:src="@drawable/ic_postpone_task"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_check_postpone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_margin"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/newtask_postpone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/newtask_check_postpone"
                            app:layout_constraintStart_toEndOf="@id/newtask_ic_postpone"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/newtask_check_postpone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/gray_text"
                            android:button="@drawable/custom_checkbox"
                            android:checked="true"
                            app:buttonTint="@color/purple_deep"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/default_margin"
                            android:background="@color/gray_stroke"
                            app:layout_constraintTop_toBottomOf="@id/newtask_ic_postpone" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/newtask_more_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/default_margin"
                    android:backgroundTint="@color/transparent"
                    android:contentDescription="@string/img_more"
                    android:src="@drawable/ic_ios_arrow_bottom"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/newtask_next_const" />

                <View
                    android:id="@+id/newtask_bottom_view"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/newtask_more_bottom" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView><!--<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"-->
