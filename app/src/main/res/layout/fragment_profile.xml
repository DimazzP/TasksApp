<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_margin"
            android:fontFamily="@font/inter_regular"
            android:text="@string/prof_my_profile"
            android:textAlignment="center"
            android:textSize="24sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/gray_text"
            app:cardCornerRadius="200dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/example_user" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_margin"
            android:fontFamily="@font/inter_bold"
            android:text="-"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_regular"
            android:text="-"
            android:textColor="@color/gray_text"
            android:textSize="15sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/default_margin_2"
            android:layout_marginTop="@dimen/default_margin"
            app:cardBackgroundColor="@color/purple_deep"
            android:layout_marginBottom="@dimen/space_margin"
            app:cardCornerRadius="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_bold"
                android:paddingVertical="8dp"
                android:text="@string/prof_edit"
                android:textColor="@color/white"
                android:textSize="19dp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_marginHorizontal="@dimen/default_margin"
            android:layout_marginVertical="@dimen/space_margin"
            android:background="@color/gray_text"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_support"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_support"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_about_us"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/small_margin"
            android:padding="@dimen/space_margin"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_logout_outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/black"
                android:layout_marginLeft="@dimen/space_margin"
                android:text="@string/prof_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>