<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.tasks.goals.detailsgoal.DetailGoalFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detgo_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingHorizontal="@dimen/default_margin_2"
            android:paddingTop="@dimen/default_margin"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/detgo_btnback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:contentDescription="@string/img_back"
                android:cropToPadding="true"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/detgo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_margin"
                android:fontFamily="@font/inter_semi"
                android:text="@string/goal_title"
                android:textColor="@color/black"
                android:textSize="26sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/detgo_btnback"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detgo_more"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi"
                android:letterSpacing="0.05"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="@string/addmem_finish"
                android:textAlignment="textEnd"
                android:textAllCaps="false"
                android:textColor="@color/purple_deep"
                app:iconPadding="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/detgo_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/default_margin"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/detgo_header">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_goal"
                android:padding="@dimen/default_margin">

                <com.example.tasksapp.view.CircularProgressBar
                    android:id="@+id/detgo_progress_bar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/detgo_title_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:paddingHorizontal="@dimen/space_margin"
                    android:text="----"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:layout_constraintStart_toEndOf="@id/detgo_progress_bar"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/detgo_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:paddingHorizontal="@dimen/space_margin"
                    android:text="----"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/detgo_progress_bar"
                    app:layout_constraintTop_toBottomOf="@id/detgo_title_goal" />

                <TextView
                    android:id="@+id/detgo_ended_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:paddingHorizontal="@dimen/space_margin"
                    android:text="@string/detgo_ended"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/detgo_progress_bar"
                    app:layout_constraintTop_toBottomOf="@id/detgo_description" />

                <TextView
                    android:id="@+id/detgo_ended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:paddingHorizontal="@dimen/space_margin"
                    android:text="--------"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/detgo_ended_help"
                    app:layout_constraintTop_toBottomOf="@id/detgo_description" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/detask_rc_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_margin"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detgo_ended_help"
                    tools:ignore="RtlSymmetry"
                    tools:itemCount="4"
                    tools:listitem="@layout/adp_photo" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/detgo_target_help"
            android:fontFamily="@font/inter_bold"
            android:textSize="24sp"
            android:text="@string/detgo_target"
            app:layout_constraintTop_toBottomOf="@id/detgo_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/default_margin_2"
            android:textColor="@color/black"
            android:paddingStart="@dimen/default_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/detgo_add_target"
            android:foregroundGravity="center"
            app:layout_constraintTop_toTopOf="@id/detgo_target_help"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/default_margin"
            app:cardCornerRadius="4dp"
            app:cardBackgroundColor="@color/purple_deep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/add_task"
                android:text="+"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <!-- TextView -->
        <TextView

            android:text="@string/detgo_target_empty"
            app:layout_constraintTop_toBottomOf="@id/detgo_target_help"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/gray_text"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- LinearLayout for Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_goal_targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/detgo_target_help"
            android:padding="8dp" />



        <TextView
            android:id="@+id/tv_riwayat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/rv_goal_targets"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_riwayat_label"
            android:background="@drawable/rounded_card_background"
            android:padding="16dp">



            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tv_riwayat_item_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mencari Referensi Travel"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/badge_riwayat_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/rounded_background_green"
                    android:padding="4dp"
                    android:minWidth="32dp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_text" />

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tv_riwayat_item_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Menabung 500.000"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_date_riwayat_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibuat: 8 Okt 24"
                    android:textColor="@color/gray_text"
                    android:background="@drawable/rounded_background_gray"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_button" />

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tv_riwayat_item_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mencari Referensi Travel"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_date_riwayat_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibuat: 6 Okt 24"
                    android:textColor="@color/gray_text"
                    android:background="@drawable/rounded_background_gray"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>