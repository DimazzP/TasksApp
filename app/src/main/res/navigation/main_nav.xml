<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tasksapp.presentation.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.tasksapp.presentation.register.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tasksapp.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_detailTaskFragment"
            app:destination="@id/detailTaskFragment" />
        <action
            android:id="@+id/action_homeFragment_to_repetitiveFragment"
            app:destination="@id/repetitiveFragment" />
        <action
            android:id="@+id/action_homeFragment_to_habitFragment"
            app:destination="@id/habitFragment" />
        <action
            android:id="@+id/action_homeFragment_to_tasknewFragment"
            app:destination="@id/newTaskFragment" />
        <action
            android:id="@+id/action_homeFragment_to_goalFragment"
            app:destination="@id/goalFragment" />
        <action
            android:id="@+id/action_homeFragment_to_teamTaskFragment"
            app:destination="@id/teamTaskFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detailGoalFragment"
            app:destination="@id/detailGoalFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailGoalFragment"
        android:name="com.example.tasksapp.presentation.tasks.goals.detailsgoal.DetailGoalFragment"
        android:label="fragment_detailGoal"
        tools:layout="@layout/fragment_detail_goal"/>
    <fragment
        android:id="@+id/teamTaskFragment"
        android:name="com.example.tasksapp.presentation.tasks.teamtask.TeamTaskFragment"
        android:label="fragment_team"
        tools:layout="@layout/fragment_team_task"/>
    <fragment
        android:id="@+id/goalFragment"
        android:name="com.example.tasksapp.presentation.tasks.goals.GoalsFragment"
        android:label="fragment_goal"
        tools:layout="@layout/fragment_goals"/>
    <fragment
        android:id="@+id/newTaskFragment"
        android:name="com.example.tasksapp.presentation.tasks.newtask.TasknewFragment"
        android:label="fragment_newTask"
        tools:layout="@layout/fragment_tasknew"/>
    <fragment
        android:id="@+id/detailTaskFragment"
        android:name="com.example.tasksapp.presentation.detailtask.DetailTaskFragment"
        android:label="fragment_detailTask"
        tools:layout="@layout/fragment_detail_task">
        <action
            android:id="@+id/action_detailTaskFragment_to_memberFragment"
            app:destination="@id/memberFragment" />
    </fragment>
    <fragment
        android:id="@+id/memberFragment"
        android:name="com.example.tasksapp.presentation.member.MemberFragment"
        android:label="fragment_member"
        tools:layout="@layout/fragment_member">
        <action
            android:id="@+id/action_memberFragment_to_addMemberFragment"
            app:destination="@id/addMemberFragment" />
    </fragment>
    <fragment
        android:id="@+id/addMemberFragment"
        android:name="com.example.tasksapp.presentation.addmember.AddMemberFragment"
        android:label="fragment_addMember"
        tools:layout="@layout/fragment_add_member">

    </fragment>
    <fragment
        android:id="@+id/repetitiveFragment"
        android:name="com.example.tasksapp.presentation.tasks.repetitivetask.RepetitiveFragment"
        android:label="fragment_repetitive"
        tools:layout="@layout/fragment_repetitive">
    </fragment>
    <fragment
        android:id="@+id/habitFragment"
        android:name="com.example.tasksapp.presentation.tasks.habitstask.HabitFragment"
        android:label="fragment_newrepep"
        tools:layout="@layout/fragment_habit">

    </fragment>
    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.tasksapp.presentation.calendar.CalendarFragment"
        android:label="fragment_calendar"
        tools:layout="@layout/fragment_calendar">
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.tasksapp.presentation.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
    </fragment>
    <fragment
        android:id="@+id/assignmentFragment"
        android:name="com.example.tasksapp.presentation.assignment.AssignmentFragment"
        android:label="fragment_assignment"
        tools:layout="@layout/fragment_assignment">
    </fragment>
</navigation>